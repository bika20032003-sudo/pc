# ==============================================================================
# منظومة مديرية أمن أوباري - وزارة الداخلية | إعدادات خادم Apache / cPanel
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. مسارات الـ API المدعومة في بيئة cPanel المشتركة
  RewriteRule ^api/force/self-update/?$ api/force-update.php [QSA,L]
  RewriteRule ^api/force/?$ api/get-force.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]

  # 2. السماح بمسارات API الأخرى بالمرور
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # 3. توجيه ملفات النظام الثابتة مباشرة إذا كانت موجودة
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. دعم تطبيقات الصفحة الواحدة (SPA Rewrite to index.html)
  RewriteRule ^ index.html [L]
</IfModule>

# تفعيل ضغط الملفات لتسريع الفتح على شبكات الهاتف (Gzip / Deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# تحسين التخزين المؤقت للملفات الثابتة
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ترويسات الحماية والأمان ومنع تخزين ملف index.html مؤقتاً لضمان وصول التحديثات فوراً
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
